ENV=development
SERVICE_NAME=glob-api
PORT=3008
JWT_SECRET=change-me
DATABASE_URL=postgres://user:password@127.0.0.1:5433/glob?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379
CONSOLE_LOG_LEVEL=debug
FILE_LOG_LEVEL=error
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASSWORD=
MAIL_FROM=Glob <you@example.com>
FILE_STORAGE_ENDPOINT=http://localhost:3008/files
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=unused
AWS_SECRET_ACCESS_KEY=unused
AWS_S3_BACKUP_BUCKET=unused
GOOGLE_CLIENT_ID=
AWS_S3_MEDIA_BUCKET=
AWS_S3_PREFIX=glob/

# Voice / video (LiveKit). URL is the wss:// address browsers connect to.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# the one person who manages who can sign in (invites, block, remove). Always allowed in.
ROOT_EMAIL=yashchauhan1775@gmail.com

# where the "Join the team" button in invite emails points
APP_URL=https://glob.yashchauhan.pro
